---
import { agencia } from '../data/agencia';
const anio = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="cv-build" content="agency-legal-v1" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Página no encontrada — {agencia.nombre}</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #0a0a0b; --surface: #101012; --line: rgba(255,255,255,0.08);
        --line-soft: rgba(255,255,255,0.05); --ink: #f6f6f6; --body: #a3a3a3;
        --muted: #8a8a8a; --accent: #4ade80;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 2rem;
        background: var(--bg); color: var(--body);
        font-family: Inter, system-ui, sans-serif; line-height: 1.7;
      }
      body::before {
        content: ''; position: fixed; inset: 0; pointer-events: none;
        background: radial-gradient(700px 400px at 70% -10%, rgba(255,255,255,0.07), transparent 70%);
      }
      main { max-width: 46ch; position: relative; }
      .mono { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
      .code { font-family: 'JetBrains Mono', monospace; font-size: clamp(4rem, 14vw, 7rem); line-height: 1; color: var(--ink); letter-spacing: -0.05em; margin: 0 0 0.4rem; }
      h1 { color: var(--ink); font-size: 1.4rem; margin: 0 0 0.6rem; letter-spacing: -0.02em; }
      p { margin: 0 0 1.4rem; font-size: 0.97rem; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      .acciones { display: flex; gap: 0.7rem; flex-wrap: wrap; margin-bottom: 2rem; }
      .pill {
        display: inline-flex; align-items: center; padding: 0.6rem 1.1rem; border-radius: 999px;
        border: 1px solid var(--line); color: var(--ink); font-size: 0.85rem;
      }
      .pill:hover { border-color: var(--accent); color: var(--accent); }
      .pill-solid { background: var(--ink); color: #0a0a0b; border-color: var(--ink); }
      .pill-solid:hover { background: var(--accent); border-color: var(--accent); color: #0a0a0b; }
      footer { margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid var(--line-soft); display: flex; gap: 1rem; flex-wrap: wrap; }
    </style>
  </head>
  <body>
    <main>
      <p class="code">404</p>
      <p class="mono">Ruta no encontrada</p>
      <h1>Esta página no existe (o cambió de lugar).</h1>
      <p>
        Puede que el enlace esté mal escrito o que la sección se haya movido. Desde aquí puedes volver al
        inicio o escribirnos directamente.
      </p>
      <div class="acciones">
        <a class="pill pill-solid" href="/">← Volver al inicio</a>
        <a class="pill" href="/cv">Ver el CV</a>
        <a class="pill" href={`https://wa.me/${agencia.whatsappNum}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
      <footer>
        <a class="mono" href="/legal/aviso-legal">Aviso legal</a>
        <a class="mono" href="/legal/privacidad">Privacidad</a>
        <a class="mono" href="/legal/cookies">Cookies</a>
        <a class="mono" href="/legal/terminos">Términos</a>
      </footer>
      <p class="mono" style="margin-top:1.4rem; font-size:0.6rem;">© {anio} {agencia.nombre}</p>
    </main>
  </body>
</html>
