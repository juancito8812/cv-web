---
import { perfil, servicios, habilidades, experiencia } from '../data/perfil';
import { proyectos } from '../data/proyectos';

const enLinea = proyectos.filter((p) => p.estado === 'linea');
const enDesarrollo = proyectos.filter((p) => p.estado === 'desarrollo');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{perfil.nombre} — {perfil.rol}</title>
    <meta name="description" content={perfil.tagline} />
    <meta property="og:title" content={`${perfil.nombre} — ${perfil.rol}`} />
    <meta property="og:description" content={perfil.tagline} />
    <meta property="og:type" content="profile" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>

    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href="#main">
          <span class="brand-mark">JR</span>
          <span class="brand-name">{perfil.nombres.split(' ')[0]}<span class="dot">.</span></span>
        </a>
        <nav>
          <a href="#perfil">Perfil</a>
          <a href="#servicios">Servicios</a>
          <a href="#experiencia">Experiencia</a>
          <a href="#proyectos">Proyectos</a>
          <a href="#contacto">Contacto</a>
        </nav>
        <a class="btn btn-sm" href={perfil.cvPdf} download>Descargar CV</a>
      </div>
    </header>

    <main id="main">
      <!-- HERO -->
      <section class="hero wrap">
        <p class="eyebrow">
          <span class="pulse"></span> Disponible para proyectos
        </p>
        <h1>
          {perfil.nombres}<br />
          <span class="grad">{perfil.apellidos}</span>
        </h1>
        <p class="rol">{perfil.rol}</p>
        <p class="tagline">{perfil.tagline}</p>

        <div class="hero-actions">
          <a class="btn" href="#proyectos">Ver proyectos en producción</a>
          <a class="btn btn-ghost" href={`mailto:${perfil.email}`}>Escríbeme</a>
        </div>

        <dl class="stats">
          <div>
            <dt>{enLinea.length}</dt>
            <dd>Sitios en línea</dd>
          </div>
          <div>
            <dt>{enDesarrollo.length}</dt>
            <dd>En desarrollo</dd>
          </div>
          <div>
            <dt>12+</dt>
            <dd>Tecnologías</dd>
          </div>
          <div>
            <dt>{perfil.ubicacion.split('·')[0].trim()}</dt>
            <dd>Base</dd>
          </div>
        </dl>
      </section>

      <!-- PERFIL -->
      <section id="perfil" class="wrap section">
        <h2><span class="num">01</span> Perfil</h2>
        <div class="cols">
          <div>
            <p class="lead">
              Desarrollador autodidacta radicado en Caracas. Empecé resolviendo problemas de mi propio
              negocio de remodelaciones y terminé construyendo y manteniendo los sistemas que hoy usan
              clientes reales: tiendas en línea, plataformas de pronósticos, generadores de QR y
              automatizaciones de mensajería.
            </p>
            <p>
              Trabajo con despliegue continuo (GitHub Actions + Cloudflare), bases de datos con reglas de
              seguridad por fila, contenedores Docker y monitoreo con alertas. Todo lo que aparece en esta
              página está publicado y se puede visitar.
            </p>
          </div>
          <aside class="card-side">
            <h3>Datos rápidos</h3>
            <ul class="facts">
              <li><span>Ubicación</span><strong>{perfil.ubicacion}</strong></li>
              <li><span>Idiomas</span><strong>Español (nativo) · Inglés técnico</strong></li>
              <li><span>Modalidad</span><strong>Remoto · Proyectos por hitos</strong></li>
              <li><span>GitHub</span><strong><a href={perfil.github}>juancito8812</a></strong></li>
            </ul>
          </aside>
        </div>
      </section>

      <!-- SERVICIOS -->
      <section id="servicios" class="wrap section">
        <h2><span class="num">02</span> Qué hago</h2>
        <div class="grid-3">
          {
            servicios.map((s, i) => (
              <article class="card">
                <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.titulo}</h3>
                <p>{s.texto}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- EXPERIENCIA -->
      <section id="experiencia" class="wrap section">
        <h2><span class="num">03</span> Experiencia</h2>
        <ol class="timeline">
          {
            experiencia.map((e) => (
              <li>
                <div class="tl-head">
                  <h3>{e.puesto}</h3>
                  <span class="period">{e.periodo}</span>
                </div>
                <ul class="bullets">
                  {e.puntos.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>

        <h3 class="sub">Habilidades</h3>
        <ul class="chips">
          {habilidades.map((h) => <li>{h}</li>)}
        </ul>
      </section>

      <!-- PROYECTOS -->
      <section id="proyectos" class="wrap section">
        <h2><span class="num">04</span> Proyectos</h2>
        <p class="section-note">
          Cada enlace abre el sitio real. Los estados se verifican automáticamente por HTTP.
        </p>

        <h3 class="sub">En producción <span class="count">{enLinea.length}</span></h3>
        <div class="grid-2">
          {
            enLinea.map((p) => (
              <a class="proj" href={p.url} target="_blank" rel="noopener noreferrer">
                <div class="proj-top">
                  <h4>{p.nombre}</h4>
                  <span class="badge live">● En línea</span>
                </div>
                <p>{p.descripcion}</p>
                <ul class="stack">
                  {p.stack.map((s) => <li>{s}</li>)}
                </ul>
                <span class="proj-link">{p.url?.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗</span>
              </a>
            ))
          }
        </div>

        <h3 class="sub">En desarrollo <span class="count">{enDesarrollo.length}</span></h3>
        <div class="grid-2">
          {
            enDesarrollo.map((p) => (
              <div class="proj proj-soon">
                <div class="proj-top">
                  <h4>{p.nombre}</h4>
                  <span class="badge soon">◐ En desarrollo</span>
                </div>
                <p>{p.descripcion}</p>
                <ul class="stack">
                  {p.stack.map((s) => <li>{s}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- CONTACTO -->
      <section id="contacto" class="wrap section">
        <h2><span class="num">05</span> Contacto</h2>
        <div class="contact-box">
          <div>
            <p class="lead">¿Tienes un proyecto o necesitas mantener algo que ya existe? Escríbeme.</p>
            <p class="contact-lines">
              <a href={`mailto:${perfil.email}`}>{perfil.email}</a><br />
              <a href={`https://wa.me/${perfil.whatsapp.replace(/[^0-9]/g, '')}`}>{perfil.whatsapp}</a>
            </p>
          </div>
          <a class="btn" href={`mailto:${perfil.email}`}>Enviar correo</a>
        </div>
      </section>
    </main>

    <footer class="wrap">
      <p>© {new Date().getFullYear()} {perfil.nombre} — Hecho con Astro, desplegado en GitHub Pages.</p>
      <p><a href={perfil.cvPdf} download>Descargar CV en PDF</a></p>
    </footer>

    <style is:global>
      :root {
        --bg: #08090c;
        --bg-2: #0e1014;
        --line: #1d2129;
        --ink: #e9edf2;
        --muted: #8b95a5;
        --accent: #34d399;
        --accent-2: #22b8cf;
        --radius: 14px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: Inter, system-ui, -apple-system, sans-serif;
        font-size: 16px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background:
          radial-gradient(700px 400px at 15% -5%, rgba(52, 211, 153, 0.12), transparent 70%),
          radial-gradient(600px 350px at 90% 0%, rgba(34, 184, 207, 0.09), transparent 70%);
        pointer-events: none;
        z-index: 0;
      }
      .wrap { width: min(1080px, 92vw); margin-inline: auto; position: relative; z-index: 1; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .skip { position: absolute; left: -999px; }
      .skip:focus { left: 1rem; top: 1rem; z-index: 99; background: #fff; color: #000; padding: 0.5rem 1rem; }

      /* HEADER */
      .top {
        position: sticky; top: 0; z-index: 20;
        backdrop-filter: blur(14px);
        background: rgba(8, 9, 12, 0.78);
        border-bottom: 1px solid var(--line);
      }
      .top-inner { display: flex; align-items: center; gap: 1.25rem; padding: 0.85rem 0; }
      .brand { display: flex; align-items: center; gap: 0.6rem; color: var(--ink); font-weight: 600; }
      .brand:hover { text-decoration: none; }
      .brand-mark {
        display: grid; place-items: center;
        width: 34px; height: 34px; border-radius: 10px;
        background: linear-gradient(145deg, var(--accent), var(--accent-2));
        color: #04120d; font-weight: 800; font-size: 0.85rem; letter-spacing: -0.02em;
      }
      .brand-name .dot { color: var(--accent); }
      .top nav { display: flex; gap: 1.1rem; margin-left: auto; }
      .top nav a { color: var(--muted); font-size: 0.9rem; font-weight: 500; }
      .top nav a:hover { color: var(--ink); text-decoration: none; }

      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 0.72rem 1.15rem; border-radius: 999px;
        background: linear-gradient(145deg, var(--accent), #10b981);
        color: #04150f; font-weight: 600; font-size: 0.92rem;
        border: 1px solid transparent;
        transition: transform 0.15s ease, opacity 0.15s ease;
        white-space: nowrap;
      }
      .btn:hover { transform: translateY(-1px); text-decoration: none; opacity: 0.94; }
      .btn-sm { padding: 0.5rem 0.9rem; font-size: 0.85rem; }
      .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }
      .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

      /* HERO */
      .hero { padding: 5.5rem 0 3.5rem; }
      .eyebrow {
        display: inline-flex; align-items: center; gap: 0.5rem;
        font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--muted); margin: 0 0 1.5rem;
      }
      .pulse {
        width: 7px; height: 7px; border-radius: 50%; background: var(--accent);
        box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6);
        animation: pulse 2.4s infinite;
      }
      @keyframes pulse {
        70% { box-shadow: 0 0 0 10px rgba(52, 211, 153, 0); }
        100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
      }
      h1 {
        font-size: clamp(2.35rem, 6.4vw, 4.4rem);
        line-height: 1.04; letter-spacing: -0.035em; font-weight: 800;
        margin: 0 0 1.1rem;
        overflow-wrap: break-word;
      }
      .grad {
        display: block;
        font-size: 0.86em;
        background: linear-gradient(100deg, var(--accent) 10%, var(--accent-2) 90%);
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }
      .rol {
        font-family: 'JetBrains Mono', monospace; font-size: 0.95rem;
        color: var(--accent); margin: 0 0 1.2rem;
      }
      .tagline { max-width: 62ch; color: #b6c0cd; font-size: 1.08rem; margin: 0 0 2rem; }
      .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 3.2rem; }

      .stats {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
        background: var(--line); border: 1px solid var(--line);
        border-radius: var(--radius); overflow: hidden; margin: 0;
      }
      .stats > div { background: var(--bg-2); padding: 1.15rem 1.25rem; }
      .stats dt { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; }
      .stats dd { margin: 0.15rem 0 0; color: var(--muted); font-size: 0.82rem; }

      /* SECTIONS */
      .section { padding: 3.5rem 0; border-top: 1px solid var(--line); }
      h2 {
        display: flex; align-items: baseline; gap: 0.8rem;
        font-size: clamp(1.5rem, 3.2vw, 2rem); letter-spacing: -0.02em;
        margin: 0 0 2rem;
      }
      .num {
        font-family: 'JetBrains Mono', monospace; font-size: 0.8rem;
        color: var(--accent); letter-spacing: 0.1em;
      }
      .cols { display: grid; grid-template-columns: 1.65fr 1fr; gap: 2.5rem; align-items: start; }
      .lead { font-size: 1.05rem; color: #c8d1db; margin-top: 0; }
      .section-note { color: var(--muted); font-size: 0.9rem; margin: -1.2rem 0 2rem; }
      .sub {
        font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.12em;
        color: var(--muted); margin: 2.6rem 0 1.1rem; display: flex; align-items: center; gap: 0.6rem;
      }
      .count {
        font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;
        background: rgba(52, 211, 153, 0.12); color: var(--accent);
        padding: 0.12rem 0.45rem; border-radius: 999px;
      }

      .card-side, .card {
        background: var(--bg-2); border: 1px solid var(--line);
        border-radius: var(--radius); padding: 1.35rem;
      }
      .card-side h3, .card h3 { margin: 0 0 0.6rem; font-size: 1rem; }
      .card p { margin: 0; color: var(--muted); font-size: 0.92rem; }
      .card-num {
        font-family: 'JetBrains Mono', monospace; font-size: 0.72rem;
        color: var(--accent); display: block; margin-bottom: 0.7rem;
      }
      .facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
      .facts li { display: grid; gap: 0.1rem; font-size: 0.86rem; }
      .facts span { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; }
      .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
      .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
      /* 5 tarjetas: la última ocupa 2 columnas para no dejar hueco en la fila final */
      .grid-3 > :last-child:nth-child(odd) { grid-column: span 2; }

      /* TIMELINE */
      .timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.6rem; }
      .timeline > li {
        border-left: 2px solid var(--line); padding-left: 1.3rem; position: relative;
      }
      .timeline > li::before {
        content: ''; position: absolute; left: -6px; top: 0.55rem;
        width: 10px; height: 10px; border-radius: 50%;
        background: var(--bg); border: 2px solid var(--accent);
      }
      .tl-head { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: baseline; }
      .tl-head h3 { margin: 0; font-size: 1.05rem; }
      .period {
        font-family: 'JetBrains Mono', monospace; font-size: 0.76rem; color: var(--accent);
      }
      .bullets { margin: 0.6rem 0 0; padding-left: 1.1rem; color: var(--muted); font-size: 0.92rem; }
      .bullets li { margin-bottom: 0.35rem; }

      .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.45rem; padding: 0; margin: 0; }
      .chips li {
        font-size: 0.82rem; padding: 0.32rem 0.7rem; border-radius: 999px;
        background: var(--bg-2); border: 1px solid var(--line); color: #c2cbd6;
      }

      /* PROYECTOS */
      .proj {
        display: flex; flex-direction: column; gap: 0.6rem;
        background: var(--bg-2); border: 1px solid var(--line);
        border-radius: var(--radius); padding: 1.3rem; color: var(--ink);
        transition: border-color 0.18s ease, transform 0.18s ease;
      }
      .proj:hover { border-color: rgba(52, 211, 153, 0.5); transform: translateY(-2px); text-decoration: none; }
      .proj-top { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; }
      .proj h4 { margin: 0; font-size: 1.02rem; letter-spacing: -0.01em; }
      .proj p { margin: 0; color: var(--muted); font-size: 0.9rem; }
      .badge {
        font-size: 0.7rem; font-weight: 600; padding: 0.18rem 0.5rem;
        border-radius: 999px; white-space: nowrap;
      }
      .badge.live { background: rgba(52, 211, 153, 0.14); color: var(--accent); }
      .badge.soon { background: rgba(139, 149, 165, 0.14); color: #a4aebc; }
      .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0; margin: 0; }
      .stack li {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem; color: #97a2b1;
        border: 1px solid var(--line); border-radius: 5px; padding: 0.1rem 0.4rem;
      }
      .proj-link { font-size: 0.78rem; color: var(--accent); margin-top: auto; }
      .proj-soon { opacity: 0.86; }

      /* CONTACTO */
      .contact-box {
        display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap;
        background: linear-gradient(140deg, rgba(52, 211, 153, 0.09), var(--bg-2) 55%);
        border: 1px solid var(--line); border-radius: var(--radius); padding: 2rem;
      }
      .contact-box .lead { margin-bottom: 0.8rem; }
      .contact-lines { margin: 0; font-family: 'JetBrains Mono', monospace; font-size: 0.88rem; line-height: 2; }

      footer {
        display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
        padding: 2rem 0 3rem; border-top: 1px solid var(--line);
        color: var(--muted); font-size: 0.82rem;
      }
      footer p { margin: 0; }

      /* RESPONSIVE */
      @media (max-width: 860px) {
        .top nav { display: none; }
        .cols { grid-template-columns: 1fr; gap: 1.6rem; }
        .grid-2 { grid-template-columns: 1fr; }
        .grid-3 { grid-template-columns: 1fr; }
        .grid-3 > :last-child:nth-child(odd) { grid-column: auto; }
        .stats { grid-template-columns: repeat(2, 1fr); }
        .hero { padding-top: 3.5rem; }
      }

      /* PRINT */
      @media print {
        :root {
          --bg: #fff; --bg-2: #fff; --ink: #111; --muted: #3b3b3b;
          --line: #d6d6d6; --accent: #067a5b; --accent-2: #067a5b;
        }
        body::before, .top, .hero-actions, .skip, .stats, .badge, .pulse, footer { display: none !important; }
        body { font-size: 9.6pt; line-height: 1.38; }
        .wrap { max-width: 100%; padding: 0 !important; }
        .hero { min-height: 0 !important; padding: 0 0 .5rem !important; display: block !important; }
        .hero .cols { display: block !important; }
        h1 { font-size: 19pt !important; margin: 0 0 .25rem !important; }
        .grad {
          display: inline !important; font-size: 1em !important;
          background: none !important; -webkit-text-fill-color: #067a5b; color: #067a5b;
        }
        .rol { font-size: 9.5pt !important; margin: .15rem 0 .45rem !important; }
        .tagline { font-size: 9.2pt !important; max-width: 100% !important; margin: 0 0 .4rem !important; }
        .section { padding: .65rem 0 !important; border-top: 1px solid #ddd; page-break-inside: auto; }
        .sec-head, .section-note { margin-bottom: .35rem !important; }
        .grid-2, .cols, .chips, .contact-lines { gap: .35rem !important; }
        .card, .card-side, .proj, .contact-box, .facts > * { page-break-inside: avoid; padding: .4rem .55rem !important; margin-bottom: .3rem !important; }
        .proj, .card, .card-side, .contact-box { border: 1px solid #ddd; }
        .timeline .tl-head { page-break-after: avoid; }
        .btn, .btn-sm { border: 1px solid #bbb; padding: .15rem .4rem; font-size: 8.5pt; }
        a { color: #067a5b; text-decoration: none; }
      }
    </style>
  </body>
</html>
